---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ContactSection from "../components/ContactSection.astro";
import { services, site } from "../data/site";
---

<BaseLayout
  title="Services"
  description="Family, cosmetic, preventive and restorative dentistry at Meadowbrook Dental in Auburn Hills, Michigan."
>
  <section class="intro section" aria-labelledby="services-title">
    <div class="shell intro__inner">
      <p class="eyebrow">Our services</p>
      <h1 id="services-title">Comprehensive care for every smile</h1>
      <p class="intro__lede">
        Whatever your smile needs, we make every visit comfortable, gentle and
        welcoming. Everything below happens under one roof in {site.locality}.
      </p>

      {/* Plain anchors to the section headings -- no JS, and deliberately not
          sticky. A sticky bar would eat viewport height on a phone and can
          cover the very heading it just jumped to, and keeping it honest as you
          scroll would need scroll-spy and aria-current. For four links that is
          not worth it. */}
      <nav class="jump" aria-label="Services on this page">
        <ul class="jump__list">
          {
            services.map((service) => (
              <li>
                <a href={`#${service.slug}`}>{service.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    services.map((service, i) => (
      <section
        {/* First section takes the white ground so it separates from the
            gradient intro above it, which ends on cream at its left edge. */}
        class:list={["svc", "section", { "svc--alt": i % 2 === 0 }]}
        id={service.slug}
        aria-labelledby={`${service.slug}-title`}
      >
        {/* Two columns: the icon and heading hold the left, the copy the
            right. A single 68ch column left most of a 1320px shell empty and
            read as a tablet layout. The left column is also where a photo
            drops in later without the structure changing. */}
        <div class="shell svc__inner">
          <div class="svc__head">
            <Icon name={`service-${i + 1}`} width={72} class="svc__icon" />
            <h2 id={`${service.slug}-title`}>{service.title}</h2>
          </div>

          <div class="svc__copy">
            {service.detail.paragraphs.map((para) => (
              <p>{para}</p>
            ))}

            {service.detail.list && (
              <>
                <p class="svc__list-intro">{service.detail.listIntro}</p>
                <ul class="svc__list">
                  {service.detail.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </div>
      </section>
    ))
  }

  <ContactSection />
</BaseLayout>

<style>
  /* The same gradient the homepage hero uses. Without it this intro sat on
     plain cream directly above a cream section, and the two read as one block
     with a heading floating in the middle of it. */
  .intro {
    background: var(--grad-hero);
  }

  .intro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    text-align: center;
    /* Wide enough to hold the heading on one line and all four pills on one
       row. At 48rem the pills wrapped 3 + 1, which read as an accident. */
    max-width: 62rem;
  }

  /* Capped independently of its container. The block above got wider for the
     heading and the pills, but this is running text -- at 62rem it would set
     around 110 characters a line. */
  .intro__lede {
    max-width: 46rem;
    text-wrap: pretty;
  }

  .jump {
    margin-top: 1.25rem;
  }

  .jump__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Pills rather than a plain link row: they read as a set of destinations
     rather than running prose, and each one clears the 24x24 target minimum in
     2.5.8 comfortably. */
  .jump__list a {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--teal);
    border-radius: var(--radius-pill);
    color: var(--teal);
    font-size: var(--step-small);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }

  .jump__list a:hover,
  .jump__list a:focus-visible {
    background: var(--chip);
  }

  .svc__inner {
    display: grid;
    gap: 1.5rem;
  }

  /* Same split and same breakpoint as the contact block below, so the second
     column starts on the same line down the whole page. A 20rem left column
     put the copy at x=450 where the contact card starts at x=745, and the
     mismatch was visible as you scrolled. The wide left column is also the
     right shape for the photo that goes there later. */
  @media (min-width: 62rem) {
    .svc__inner {
      grid-template-columns: 1fr 1fr;
      /* Identical to the contact block's gap, not merely similar. With 1fr 1fr
         the gap decides where the second column starts, so a different clamp
         left the two 4px apart — close enough to look like a mistake rather
         than a choice. */
      column-gap: clamp(2.5rem, 6vw, 4rem);
      align-items: start;
    }
  }

  .svc__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .svc__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    /* Tightened from 68ch, which at this column width barely bit -- the text
       ran nearly the full 620px and set long lines.

       The cap lives on the copy, not on the grid column, so the column still
       starts where the contact form card starts. Narrowing the grid instead
       would have tightened the measure and broken that alignment in one move. */
    max-width: 58ch;
  }

  .svc__inner p {
    margin: 0;
    text-wrap: pretty;
  }

  .svc__icon {
    flex: none;
  }

  /* Alternating ground so the four sections read as separate bands without
     needing rules between them. */
  .svc--alt {
    background: var(--white);
  }

  .svc__list-intro {
    font-weight: 700;
  }

  .svc__list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* Nothing on this site is sticky today, but an anchored heading landing hard
     against the top of the window reads badly either way. */
  .svc {
    scroll-margin-top: 1.5rem;
  }
</style>
