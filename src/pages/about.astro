---
import BaseLayout from "../layouts/BaseLayout.astro";
import Testimonials from "../components/Testimonials.astro";
import ContactSection from "../components/ContactSection.astro";
import { site, doctorBio, motto } from "../data/site";
---

<BaseLayout
  title="About Dr. Tejal Soni"
  description="Dr. Tejal Soni has practiced in Michigan since 2005. Meet the dentist behind Meadowbrook Dental in Auburn Hills — her training, her affiliations, and what she loves about the work."
>
  <section class="bio section" aria-labelledby="bio-title">
    {/* Source order is the mobile order: eyebrow, name, photo, then the
        biography. On desktop the photo moves to its own column via grid areas.
        Only the photo moves, and it is not focusable, so the visual order never
        parts company with the focus order (1.3.2 / 2.4.3). Same rule the
        homepage about section follows. */}
    <div class="shell bio__inner">
      <p class="eyebrow bio__eyebrow">About</p>
      <h1 id="bio-title" class="bio__name">Dr. Tejal Soni, DDS</h1>

      <div class="bio__photo">
        <img
          src="/images/dr-soni.jpg"
          alt="Dr. Tejal Soni, DDS"
          width="373"
          height="462"
        />
      </div>

      <div class="bio__body">
        {doctorBio.map((para) => <p>{para}</p>)}
      </div>

      <div class="bio__actions">
        <a class="btn btn--solid" href="/contact/">Book an appointment</a>
        <a class="btn btn--outline" href={site.phoneHref}>
          Call {site.phone}
        </a>
      </div>
    </div>
  </section>

  {/* --teal-brand is legal here: at this size the 3:1 large-text threshold
      applies rather than 4.5:1, and the brand teal clears it on cream. */}
  <section class="motto" aria-labelledby="motto-title">
    <div class="shell">
      <p class="motto__text" id="motto-title">{motto}</p>
    </div>
  </section>

  <Testimonials />
  <ContactSection />
</BaseLayout>

<style>
  .bio__inner {
    display: grid;
    gap: 1.75rem;
  }

  .bio__photo {
    background: var(--grad-panel);
    border-radius: var(--radius-card);
    padding: clamp(1rem, 3vw, 2.2rem);
  }

  .bio__photo img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    display: block;
  }

  .bio__body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .bio__body p {
    margin: 0;
    text-wrap: pretty;
  }

  .bio__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }

  .motto {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .motto__text {
    margin: 0;
    text-align: center;
    text-wrap: balance;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.125rem);
    line-height: 1.2;
    color: var(--teal-brand);
  }

  @media (min-width: 62rem) {
    .bio__inner {
      grid-template-columns: 429fr 648fr;
      /* Slack goes to the trailing row, never to `body` — with 1fr on the
         paragraph row the buttons get pushed to the bottom of the block, away
         from the copy they belong to. */
      grid-template-rows: auto auto auto auto 1fr;
      column-gap: clamp(2rem, 5vw, 3.3rem);
      align-items: start;
      grid-template-areas:
        "photo eyebrow"
        "photo name"
        "photo body"
        "photo actions"
        "photo .";
    }
    .bio__eyebrow {
      grid-area: eyebrow;
    }
    .bio__name {
      grid-area: name;
    }
    .bio__photo {
      grid-area: photo;
      position: sticky;
      top: 2rem;
    }
    .bio__body {
      grid-area: body;
    }
    .bio__actions {
      grid-area: actions;
    }
  }
</style>
