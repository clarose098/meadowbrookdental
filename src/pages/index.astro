---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import AboutDoctor from "../components/AboutDoctor.astro";
import Testimonials from "../components/Testimonials.astro";
import ContactSection from "../components/ContactSection.astro";
---

{/* Note the plain "&" in the title below: it is a prop, not markup. Astro
    escapes props on output, so writing &amp; there double-escapes and the
    browser tab shows a literal "&amp;". */}
<BaseLayout
  title="Family & Cosmetic Dentistry in Auburn Hills, MI"
  description="Dr. Tejal Soni has cared for Auburn Hills families for nearly three decades. Gentle, personalized dentistry — from routine cleanings to complete smile makeovers."
>
  <Hero />
  <AboutDoctor />
  <Services />
  <Testimonials />
  <ContactSection />
</BaseLayout>
