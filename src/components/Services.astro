---
import { services } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h1" | "h2";
/* Card titles sit one level below the section heading, so the outline never
   skips a level regardless of which page this lands on. */
const CardHeading = `h${headingLevel + 1}` as "h2" | "h3";
---

<section class="services section" aria-labelledby="services-title">
  <div class="shell services__inner">
    <div class="services__intro">
      <p class="eyebrow">Our services</p>
      <Heading id="services-title">Comprehensive care for every smile</Heading>
      <p>
        Whatever your smile needs, we make every visit comfortable, gentle, and
        welcoming.
      </p>
    </div>

    {/* A list, because it is one -- the count is announced, and each service is
        navigable as an item. Desktop paints them as cards; mobile keeps the
        plain stacked list the mobile frame shows. */}
    <ul class="services__list">
      {
        services.map((service, i) => (
          <li class="service">
            {/* Icons run in the same order as the cards in the Figma file:
                tooth, sparkle, shield, smile. The pale chip circle is part of
                the exported asset. */}
            <Icon name={`service-${i + 1}`} width={72} class="service__icon" />
            <CardHeading>{service.title}</CardHeading>
            <p>{service.description}</p>
          </li>
        ))
      }
    </ul>

    <a class="btn btn--solid services__cta" href="/services/">
      View all our services
    </a>
  </div>
</section>

<style>
  .services__inner {
    display: grid;
    justify-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  /* 48rem rather than 60ch. At 60ch the intro sentence broke one word early and
     left "welcoming." alone on its own line; this holds it on a single line and
     puts the section heading back on one line too, which is how the Figma file
     sets them. Wide for running text, but this is one short centred sentence,
     not a paragraph anyone reads at length. */
  .services__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    text-align: center;
    max-width: 48rem;
  }

  /* Between the two breakpoints the sentence still has to wrap somewhere.
     `pretty` tells the browser to avoid leaving a single word on the last line,
     so the orphan cannot come back at an intermediate width. Unsupported
     browsers just wrap normally. */
  .services__intro > p:last-of-type {
    text-wrap: pretty;
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.service__icon) {
    flex: none;
  }

  /* The mobile frame lists the services as plain text with no icons; they
     appear only once the cards do. */
  @media (max-width: 47.99rem) {
    :global(.service__icon) {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .services__list {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: 1.4rem;
    }
    .service {
      background: var(--white);
      border-radius: 20px;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      box-shadow: 0 0 20px rgb(0 0 0 / 0.05);
      gap: 1.875rem;
    }
  }
</style>
