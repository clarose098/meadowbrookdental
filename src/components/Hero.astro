---
import Carousel from "./Carousel.astro";
import { site, heroPhotos } from "../data/site";
---

<section class="hero section" aria-labelledby="hero-title">
  <div class="shell hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title">
        {/* "Trusted" rather than "The Best": Michigan's dental advertising
            rules prohibit misleading claims and unprovable superlatives are the
            textbook case, with the FTC separately expecting substantiation for
            objective claims. "Trusted" is puffery -- no one has to prove it. */}
        Trusted Family &amp; Cosmetic Dentistry in {site.locality}, {site.region}
      </h1>
      <p class="hero__lede">
        For nearly three decades, Dr. Tejal Soni has helped families smile with
        gentle, personalized care &mdash; from routine cleanings to complete
        smile makeovers. We&rsquo;d love to welcome you to {site.name}.
      </p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="/contact/">Book an appointment</a>
        <a class="btn btn--outline" href={site.phoneHref}>
          Call {site.phone}
        </a>
      </div>
    </div>

    <div class="hero__media">
      <Carousel
        id="hero-carousel"
        label="Photos of the practice"
        itemNoun="photo"
        count={heroPhotos.length}
        /* 4s rather than 3: the captions run to about eight words, and three
           seconds is not long enough to read one and take in the artwork
           behind it. Only this carousel autoplays — the testimonials are
           paragraphs of prose, and moving those under someone mid-sentence
           would be actively hostile. */
        autoplay={4000}
      >
        {
          heroPhotos.map((photo, i) => {
            const href = "href" in photo ? photo.href : undefined;

            /* Only the first slide is on screen at load. The other three are
               offer graphics around 200KB each, so eager-loading them would
               cost roughly 600KB nobody has asked to see yet. */
            const inner = (
              <>
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width="629"
                  height="362"
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding={i === 0 ? "sync" : "async"}
                />
                <figcaption>{photo.caption}</figcaption>
              </>
            );

            return (
              <figure
                class="hero__slide"
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${heroPhotos.length}`}
              >
                {/* One link around the image and its caption together, rather
                    than two adjacent links to the same place. The accessible
                    name becomes the image's text followed by the caption --
                    slightly verbose, but wholly descriptive, and it means the
                    offer is not trapped in a bitmap for anyone. */}
                {href ? (
                  <a class="hero__slide-link" href={href}>
                    {inner}
                  </a>
                ) : (
                  inner
                )}
              </figure>
            );
          })
        }
      </Carousel>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--grad-hero);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    /* Copy sits centred against the slider. This does not change the row's
       height -- that is still set by whichever column is taller -- so the
       controls stay where they are relative to the fold. */
    align-items: center;
  }

  /* Grid children default to min-width: auto, so anything wide inside them
     (here the carousel) can push the column past the container. */
  .hero__inner > * {
    min-width: 0;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* No measure cap: the lede fills the column exactly as the heading does, so
     the two share a right edge instead of leaving a ragged gap beside the
     paragraph. Safe to drop here because the column itself is the constraint --
     at its widest the line runs about 68 characters, still inside the 45-75
     readability range. Do not reuse this on a full-width block. */
  .hero__lede {
    max-width: none;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }

  /* The card sits on --grad-hero, whose warm end is --cream -- the same colour
     as the card, so on the left of the viewport the panel simply vanished into
     the background. A soft shadow separates the two without introducing a
     border, which at this size would read as a hard frame. */
  .hero__media {
    background: var(--cream);
    border-radius: var(--radius-card);
    padding: clamp(1rem, 3vw, 2rem);
    box-shadow:
      0 1px 2px rgb(47 96 107 / 0.06),
      0 12px 32px -8px rgb(47 96 107 / 0.16);
  }

  .hero__slide {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero__slide img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
  }

  /* The link is the slide's layout box, so it repeats the figure's column
     stacking rather than sitting inside it as an inline run. */
  .hero__slide-link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
  }

  /* The caption is the only part that reads as a link, so it carries the
     underline on hover. The image lifting or tinting would fight the offer
     artwork it sits on. */
  .hero__slide-link:hover figcaption,
  .hero__slide-link:focus-visible figcaption {
    text-decoration: underline;
  }

  .hero__slide figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--teal);
    text-align: center;
  }

  @media (min-width: 62rem) {
    .hero__inner {
      grid-template-columns: 547fr 694fr;
    }

    /* Tighter than .section's 72px. On a 13" laptop the browser chrome leaves
       roughly a 750px viewport, and the slider's controls were landing at
       787px -- just under the fold, so the carousel read as a static image.
       Top only: the bottom padding keeps the rhythm between sections. */
    .hero {
      padding-top: 3rem;
    }
  }
</style>
