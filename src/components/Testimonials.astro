---
import Carousel from "./Carousel.astro";
import { testimonials } from "../data/site";
---

{/* Ground is --grad-testimonial, which is materially darker than the Figma
    original. The reasoning lives on the token; the short version is that the
    amber stars are illegible on a teal that light. On this ground white text
    reaches 5.92:1, the stars 3.15:1 and the idle dots 4.20:1. */}
<section class="testimonials section" aria-labelledby="testimonials-title">
  <div class="shell">
    {/* The teal lives on this card, not on the section. On the section it was
        full-bleed, which made its border-radius meaningless -- the corners were
        off-screen. The design insets it to the content width. */}
    <div class="testimonials__card">
      <h2 id="testimonials-title" class="testimonials__title">
        <span>What our patients say</span>
      </h2>

      <Carousel
        id="testimonial-carousel"
        label="Patient reviews"
        itemNoun="review"
        count={testimonials.length}
      >
        {
          testimonials.map((item, i) => (
          <figure
            class="testimonial"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${testimonials.length}`}
          >
            <p class="testimonial__rating">
              <span class="testimonial__stars" aria-hidden="true">
                {"★".repeat(item.rating)}
              </span>
              <span class="visually-hidden">
                Rated {item.rating} out of 5
              </span>
            </p>
            {item.placeholder && (
              <span class="placeholder-badge">Placeholder</span>
            )}
            <blockquote>
              <p>{item.quote}</p>
            </blockquote>
            <figcaption>{item.author}</figcaption>
          </figure>
          ))
        }
      </Carousel>
    </div>
  </div>
</section>

<style>
  .testimonials {
    /* The active dot picks up the amber; idle dots stay white. */
    --carousel-dot-active: var(--star);
  }

  .testimonials__card {
    background: var(--grad-testimonial);
    color: var(--white);
    border-radius: var(--radius-card);
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3.5rem);
  }

  /* Rules flanking the label, per the design. They are pure decoration, so
     they carry no contrast requirement and sit at a soft white. */
  .testimonials__title {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 2.5rem);
    font-size: var(--step-body);
    font-weight: 700;
    text-transform: uppercase;
    font-family: var(--font-body);
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .testimonials__title::before,
  .testimonials__title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: rgb(255 255 255 / 0.45);
  }

  .testimonials__title span {
    flex: none;
    text-align: center;
  }

  .testimonial {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .testimonial__rating {
    margin: 0;
  }

  .testimonial__stars {
    color: var(--star);
    font-size: 1.3rem;
    letter-spacing: 0.25em;
  }

  .testimonial blockquote {
    margin: 0;
    max-width: 60ch;
  }

  .testimonial blockquote p {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: var(--leading-body);
  }

  .testimonial figcaption {
    font-weight: 700;
    font-size: 24px;
  }

  .testimonials :focus-visible {
    outline-color: var(--white);
  }
</style>
