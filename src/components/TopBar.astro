---
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

{/* Utility strip above the header. Two of the three items are shown on desktop
    only, matching the mobile frame -- they are supplementary, and hiding them
    with `display: none` keeps them out of the accessibility tree too, which is
    what we want here (no duplicate announcements). */}
<div class="topbar">
  <div class="shell topbar__inner">
    {/* tint=currentColor throughout: topbar-2 exports at #2C9CA6, which is
        2.13:1 on this ground. Inheriting the bar's white gives 6.99:1. */}
    <p class="topbar__item topbar__item--wide">
      <Icon name="topbar-2" width={18} tint="currentColor" />
      <span>Accepting new patients</span>
    </p>
    <p class="topbar__item topbar__item--wide">
      <Icon name="topbar-2" width={18} tint="currentColor" />
      <span>Most insurance welcome</span>
    </p>
    <p class="topbar__item topbar__contact">
      <span>{site.dentist} &bull; <a href={site.phoneHref}>{site.phone}</a></span>
      <Icon name="topbar-1" width={17} tint="currentColor" />
    </p>
  </div>
</div>

<style>
  .topbar {
    background: var(--teal-deep); /* white text sits at 6.99:1 here */
    color: var(--white);
    font-size: var(--step-body);
  }

  .topbar__inner {
    display: flex;
    justify-content: flex-end;
    gap: clamp(1rem, 4vw, 3rem);
    padding-block: 0.5rem;
  }

  .topbar__item {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .topbar__contact {
    margin-inline-start: auto;
  }

  .topbar a {
    color: inherit;
  }

  .topbar :focus-visible {
    outline-color: var(--white);
  }

  @media (max-width: 47.99rem) {
    .topbar__item--wide {
      display: none;
    }
    .topbar__inner {
      justify-content: center;
    }
    .topbar__contact {
      margin-inline-start: 0;
    }
  }
</style>
