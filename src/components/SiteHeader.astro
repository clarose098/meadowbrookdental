---
import { site, nav } from "../data/site";
import Icon from "./Icon.astro";

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="shell header__inner">
    <a class="logo" href="/">
      {/* Logotype. WCAG 1.4.3 exempts text that is part of a logo or brand
          name from the contrast minimum, which is why this keeps
          --teal-brand at body weight where other text could not. */}
      <Icon name="logo-tooth" width={41} height={50} tint="currentColor" class="logo__mark" />
      <span class="logo__text">
        <span class="logo__name">{site.name}</span>
        <span class="logo__tagline">{site.tagline}</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="menu-toggle__bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--solid nav__cta" href="/contact/">Book an appointment</a>
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--cream);
    /* The mobile nav panel is absolutely positioned against this. Without it
       the panel resolved against the page instead of the header, which put it
       off-screen. */
    position: relative;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--teal-brand);
  }
  :global(.logo__mark) {
    width: 2.1rem;
    height: 2.55rem;
    flex: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.68rem);
  }
  .logo__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.9rem, 0.8rem + 0.5vw, 1.35rem);
    align-self: flex-end;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 49px;
    height: 49px;
    border-radius: 50%;
    border: 1px solid var(--teal);
    background: transparent;
    cursor: pointer;
    flex: none;
  }
  .menu-toggle__bars {
    display: grid;
    gap: 4px;
    width: 25px;
  }
  /* Bars fold into a close cross while the panel is open. The button's
     accessible name stays "Menu" throughout -- aria-expanded already announces
     open/closed, and renaming the control mid-interaction gives screen reader
     users a second, redundant signal to reconcile. The cross is for sighted
     users, who have no equivalent of aria-expanded. */
  .menu-toggle__bars span {
    display: block;
    height: 2px;
    background: var(--ink);
    transition:
      transform var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  /* Bars are 2px with a 4px gap, so the outer two travel 6px to meet in the
     middle before rotating. */
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Scoped to the list, not the whole nav. `.nav a` also matched .nav__cta and,
     being more specific than .btn--solid, repainted the button's label ink on
     the teal fill -- 2.32:1, dropping to 1.73:1 at the gradient's dark end. */
  .nav__list a {
    color: var(--ink);
    text-transform: uppercase;
    /* No underline at rest: this is navigation, so position and grouping
       already carry the role, and a row of underlines is noise. It returns on
       hover and focus. */
    text-decoration: none;
  }
  .nav__list a:hover,
  .nav__list a:focus-visible {
    text-decoration: underline;
  }
  /* Current page is marked by weight as well as aria-current, so it does not
     depend on colour. */
  .nav__list a[aria-current="page"] {
    font-weight: 700;
  }

  /* ---- Mobile: nav is a disclosure panel ---- */
  @media (max-width: 61.99rem) {
    .nav {
      position: absolute;
      /* Drops directly below the header, so the logo and the toggle stay
         visible while the menu is open. */
      top: 100%;
      left: 0;
      right: 0;
      background: var(--cream);
      padding: var(--gutter);
      display: none;
      flex-direction: column;
      gap: 1.5rem;
      z-index: 20;
      border-top: 1px solid rgb(0 0 0 / 0.08);
      box-shadow: 0 12px 20px rgb(0 0 0 / 0.08);
    }
    .header:has(.menu-toggle[aria-expanded="true"]) .nav {
      display: flex;
    }
    .nav__list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  /* ---- Desktop: nav is always visible, toggle is not rendered ---- */
  @media (min-width: 62rem) {
    .menu-toggle {
      display: none;
    }
    /* The gap before the button is deliberately larger than the gaps between
       the links. They were both clamp(1.5rem, 3vw, 3.75rem), which left 43px
       either side of the boundary and made the CTA read as a fifth nav item
       crowding the fourth. Links now group tighter, the button stands apart. */
    .nav {
      display: flex;
      align-items: center;
      gap: clamp(2rem, 4.5vw, 5rem);
    }
    .nav__list {
      display: flex;
      gap: clamp(1.25rem, 2.4vw, 2.75rem);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const panel = document.getElementById("site-nav");

  if (toggle && panel) {
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const focusables = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.offsetParent !== null);

    function setOpen(open: boolean) {
      toggle!.setAttribute("aria-expanded", String(open));
      if (open) {
        focusables()[0]?.focus();
      }
    }

    toggle.addEventListener("click", () => setOpen(!isOpen()));

    // Escape closes and returns focus to the trigger, so a keyboard user is
    // never stranded inside a panel they cannot see the edges of.
    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return;

      if (event.key === "Escape") {
        setOpen(false);
        toggle!.focus();
        return;
      }

      if (event.key !== "Tab") return;

      // Trap: while the panel is open, Tab cycles within it.
      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || active === toggle)) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // A click outside is a dismissal too, but focus goes back to the trigger
    // rather than nowhere.
    document.addEventListener("click", (event) => {
      if (!isOpen()) return;
      const target = event.target as Node;
      if (!panel!.contains(target) && !toggle!.contains(target)) {
        setOpen(false);
      }
    });

    // If the viewport crosses into desktop while the panel is open, reset the
    // state -- otherwise aria-expanded lies about a nav that is now permanent.
    const desktop = window.matchMedia("(min-width: 62rem)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) toggle!.setAttribute("aria-expanded", "false");
    });
  }
</script>
