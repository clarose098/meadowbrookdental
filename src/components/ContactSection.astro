---
import { site, hours } from "../data/site";

interface Props {
  headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h1" | "h2";
const FormHeading = `h${headingLevel + 1}` as "h2" | "h3";
---

<section class="contact section" aria-labelledby="contact-title">
  <div class="shell contact__inner">
    <div class="contact__info">
      <p class="eyebrow">Get in touch</p>
      <Heading id="contact-title">Come visit our {site.locality} office</Heading>
      <p>
        Call, email, or stop by &mdash; we&rsquo;d love to welcome you and your
        family.
      </p>

      {/* Label/value pairs, so a description list rather than divs.
          The icons are CSS backgrounds rather than elements: they are purely
          decorative (every one sits beside its own label), and a <dl> may only
          contain dt/dd pairs, so this keeps the markup valid without wrapping
          them in something meaningless. */}
      <dl class="details">
        <div class="details__row details__row--phone">
          <dt>Phone</dt>
          <dd><a href={site.phoneHref}>{site.phone}</a></dd>
        </div>
        <div class="details__row details__row--email">
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div class="details__row details__row--hours">
          <dt>Hours</dt>
          <dd>
            <dl class="hours">
              {
                hours.map((entry) => (
                  <div class="hours__row">
                    <dt>
                      <span aria-hidden="true">{entry.short}</span>
                      <span class="visually-hidden">{entry.day}</span>
                    </dt>
                    <dd>{entry.time}</dd>
                  </div>
                ))
              }
            </dl>
          </dd>
        </div>
      </dl>
    </div>

    <div class="contact__form-card">
      <FormHeading id="form-title">Request an appointment</FormHeading>
      <p class="contact__required-note" id="required-note">
        Fields marked <span aria-hidden="true">*</span>
        <span class="visually-hidden">required</span> are required.
      </p>

      {/*
        Netlify picks the form up by scanning the deployed HTML at build time,
        which is why this is real markup and not JS-rendered.
        - `data-netlify` registers it.
        - The hidden `form-name` input is what Netlify matches the POST against.
        - `netlify-honeypot` names a decoy field: bots fill it, people never see
          it. This is deliberately used INSTEAD of a CAPTCHA -- CAPTCHAs are an
          accessibility barrier, and a honeypot costs the user nothing.
        The honeypot is hidden from assistive tech too (aria-hidden +
        tabindex="-1"), so it is never announced or tabbed into.
      */}
      <form
        name="contact"
        method="POST"
        action="/thank-you/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        aria-labelledby="form-title"
        aria-describedby="required-note"
      >
        <input type="hidden" name="form-name" value="contact" />

        <p class="honeypot" aria-hidden="true">
          <label>
            Do not fill this in
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        {/* First in the form, ahead of the name fields, for two reasons: it is
            the routing question the front desk actually needs, and it puts the
            emergency notice at the top rather than four fields down. A form is
            asynchronous — nobody may read it until Monday — so anyone in real
            pain has to be pointed at the phone before they start filling it in.
            That is also why there is no "urgent" option in the list below:
            offering one would imply this is a valid channel for urgent care. */}
        <p class="form-urgent">
          {/* Points at the main line now that the separate emergency number is
              gone -- they were the same number anyway. The notice itself stays:
              a form is asynchronous, and someone in pain needs the phone. */}
          {/* Explicit {" "} — Astro strips the trailing space at a line end,
              which runs "please" straight into the link text. */}
          If this is a dental emergency, please{" "}
          <a href={site.phoneHref}>call us on {site.phone}</a> rather than using
          this form.
        </p>

        <div class="field">
          <label for="reason">Reason for contact <span aria-hidden="true">*</span></label>
          {/* A real <select>, not a scripted dropdown — custom ones are among
              the most common keyboard traps on the web.

              Every option is administrative. None records anything about the
              person's health, which combined with the name and phone above
              would be identifiable health information. */}
          <select id="reason" name="reason" required>
            <option value="" disabled selected>Please choose&hellip;</option>
            <option value="appointment-new">Request an appointment — new patient</option>
            <option value="appointment-current">Request an appointment — current patient</option>
            <option value="reschedule">Reschedule or cancel an appointment</option>
            <option value="billing">Insurance or billing question</option>
            <option value="other">Something else</option>
          </select>
        </div>

        <div class="field">
          <label for="first-name">First name <span aria-hidden="true">*</span></label>
          <input
            id="first-name"
            name="first-name"
            type="text"
            required
            autocomplete="given-name"
            placeholder="Enter first name"
          />
        </div>

        <div class="field">
          <label for="last-name">Last name <span aria-hidden="true">*</span></label>
          <input
            id="last-name"
            name="last-name"
            type="text"
            required
            autocomplete="family-name"
            placeholder="Enter last name"
          />
        </div>

        <div class="field">
          <label for="email">Email <span aria-hidden="true">*</span></label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="Enter email"
          />
        </div>

        <div class="field">
          <label for="phone">Phone <span aria-hidden="true">*</span></label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            autocomplete="tel"
            placeholder="Enter phone number"
          />
        </div>

        <button class="btn btn--solid" type="submit">Submit</button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--cream);
  }

  .contact__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .details {
    margin: 2.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.875rem;
  }
  .details__row {
    display: grid;
    grid-template-columns: 48px 1fr;
    column-gap: 16px;
    row-gap: 0.15rem;
    align-items: start;
  }

  /* The icon is a pseudo-element, so the <dl> keeps a valid dt/dd structure. */
  .details__row::before {
    content: "";
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 48px 48px;
  }
  .details__row > dt,
  .details__row > dd {
    grid-column: 2;
  }

  .details__row--phone::before {
    background-image: url("/icons/detail-1.svg");
  }
  .details__row--email::before {
    background-image: url("/icons/detail-2.svg");
  }
  .details__row--hours::before {
    background-image: url("/icons/detail-4.svg");
  }
  .details dt {
    font-size: 19px; /* see .eyebrow -- same large-text threshold reasoning */
    font-weight: 700;
    text-transform: uppercase;
    color: var(--teal-brand);
    line-height: 1.2;
  }
  .details dd {
    margin: 0;
  }

  .hours {
    margin: 0.35rem 0 0;
    display: grid;
    gap: 0.35rem;
  }
  .hours__row {
    display: grid;
    grid-template-columns: 5rem 1fr;
  }
  .hours dt {
    font-size: var(--step-body);
    text-transform: none;
    color: var(--ink);
    font-weight: 400;
  }
  .hours dd {
    font-variant-numeric: tabular-nums;
  }

  /* Was borrowing --grad-hero, whose warm end is --cream -- identical to this
     section's ground, so the left half of the card disappeared into it.
     --grad-form-card stays tinted at both ends, and the shadow lifts it off
     the section the way the hero slider is lifted off its own. */
  .contact__form-card {
    background: var(--grad-form-card);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow:
      0 1px 2px rgb(47 96 107 / 0.06),
      0 12px 32px -8px rgb(47 96 107 / 0.16);
  }

  .contact__required-note {
    margin-block: 0.75rem 1.5rem;
  }

  /* Full --ink and a rule to set it apart from the fields. Deliberately not
     styled as a warning in red: this is not an error state, and it should read
     as helpful direction rather than something gone wrong. */
  .form-urgent {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--teal);
    line-height: 1.4;
  }

  /* Kept at full --ink rather than a muted grey: it carries the instruction not
     to send medical details, so it needs to be read, not skimmed past. */

  form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .field label {
    font-size: var(--step-small);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .field input,
  .field textarea,
  .field select {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--placeholder);
    border-radius: 16px;
    padding: 20px 16px;
    width: 100%;
  }

  /* The unchosen prompt reads as placeholder text, so it takes the placeholder
     colour — but only while it is the selection. Once a real option is picked
     the value returns to full --ink. */
  .field select:invalid {
    color: var(--placeholder);
  }

  .field select option {
    color: var(--ink);
  }

  .field textarea {
    resize: vertical;
    min-height: 152px;
  }

  .field ::placeholder {
    color: var(--placeholder);
    opacity: 1; /* Firefox dims placeholders by default, which breaks contrast */
  }

  /* Native validation styling, applied only after the user has interacted --
     :user-invalid rather than :invalid, so an untouched form is not painted red
     on load. */
  .field input:user-invalid,
  .field textarea:user-invalid {
    border-color: var(--ink);
    border-width: 2px;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (min-width: 62rem) {
    .contact__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
