---
import { site, nav, social } from "../data/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

{/* Ground is --teal-deep, not the --teal-brand in the Figma file. On the brand
    teal, the white links here were 3.27:1 and the copyright line (white at 80%
    opacity) was 2.64:1 -- the whole footer failed. This ground carries white at
    6.99:1. The copyright also runs at full opacity rather than 80% for the same
    reason. */}
<footer class="footer">
  <div class="shell footer__inner">
    <div class="footer__brand">
      {/* Explicit lockup wrapper. This was four siblings in one grid relying on
          auto-placement, and the tagline ended up stacked under the tooth with
          the name adrift in the next column. A flex row and an inner stack say
          what is actually meant: mark beside wordmark. */}
      <div class="footer__lockup">
        {/* tint=currentColor so it inherits the footer's white. As exported
            (#2C9CA6) it would sit at 2.13:1 on this ground. */}
        <Icon name="logo-tooth" width={34} height={42} tint="currentColor" class="footer__mark" />
        <span class="footer__wordmark">
          <span class="footer__name">{site.name}</span>
          <span class="footer__tagline">{site.tagline}</span>
        </span>
      </div>
      <address class="footer__address">
        {site.street},<br />
        {site.locality}, {site.region} {site.postalCode}
      </address>

      <div class="footer__social">
        <ul class="footer__social-list">
          {social.map((item) => (
            <li>
              {item.url ? (
                <a class="social" href={item.url}>
                  {item.icon ? (
                    <Icon name={item.icon} width={20} />
                  ) : (
                    <span class="social__initial" aria-hidden="true">{item.initial}</span>
                  )}
                  <span class="visually-hidden">
                    {site.name} on {item.name}
                  </span>
                </a>
              ) : (
                /* A span, not an <a href="#">: an empty link is focusable,
                   announces as a link and does nothing. Fill the url into
                   site.ts and this becomes a real link with no other change. */
                <span class="social social--pending">
                  {item.icon ? (
                    <Icon name={item.icon} width={20} />
                  ) : (
                    <span class="social__initial" aria-hidden="true">{item.initial}</span>
                  )}
                  <span class="visually-hidden">
                    {item.name} — account not set up yet
                  </span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <nav class="footer__col" aria-label="Footer">
      <h2 class="footer__heading">Explore</h2>
      <ul class="footer__list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading">Visit</h2>
      <ul class="footer__list">
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>

  <p class="footer__legal">
    &copy; {year} {site.name} &middot; {site.dentist} &middot; {site.locality},
    Michigan
  </p>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
    color: var(--white);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem;
  }

  .footer__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .footer__lockup {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  :global(.footer__mark) {
    flex: none;
    width: 2.15rem;
    height: 2.6rem;
  }
  .footer__wordmark {
    display: flex;
    flex-direction: column;
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.1;
  }
  .footer__tagline {
    font-family: var(--font-display);
    font-style: italic;
  }
  .footer__address {
    font-style: normal;
    line-height: 1.2;
  }

  .footer__social {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .footer__social-list {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* 44px square: past the 24x24 minimum in 2.5.8, and a comfortable touch
     target once these are live links. Border sits at 55% white for 3.33:1 on
     this ground -- above the 3:1 a UI boundary needs. */
  .social {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.55);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1;
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }

  a.social:hover,
  a.social:focus-visible {
    background: rgb(255 255 255 / 0.14);
  }

  /* The lettered fallback has to hold its own beside the 20px SVGs. At the
     .social font-size it set at 16.8px, and a lowercase f fills far less of
     that box than an icon does, so Facebook looked undersized next to Yelp and
     Google. Sized by cap height rather than font-size to match them optically.
     Delete this once the Facebook SVG lands and every mark is an icon. */
  .social__initial {
    font-size: 1.5rem;
    line-height: 1;
  }

  /* Not a link yet, so it should not look clickable. */
  .social--pending {
    opacity: 0.75;
    cursor: default;
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--step-body);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.4);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer a {
    color: inherit;
  }

  /* Navigation, so no underline at rest -- the columns and headings already
     say these are links. It comes back on hover and focus so the affordance is
     never absent when someone is actually reaching for one. */
  .footer__list a {
    text-decoration: none;
  }
  .footer__list a:hover,
  .footer__list a:focus-visible {
    text-decoration: underline;
  }

  .footer :focus-visible {
    outline-color: var(--white);
  }

  /* Sits outside .shell, so it had no horizontal padding and ran flush to the
     viewport edge on a phone. Given the shell's own measure and padding here
     so the rule above it lines up with the columns rather than spanning the
     full width. */
  .footer__legal {
    max-width: calc(var(--measure) + var(--gutter) * 2);
    margin-inline: auto;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-inline: var(--gutter);
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.4);
    text-align: center;
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .footer__inner {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
