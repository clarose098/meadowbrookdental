---
import { site, nav } from "../data/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

{/* Ground is --teal-deep, not the --teal-brand in the Figma file. On the brand
    teal, the white links here were 3.27:1 and the copyright line (white at 80%
    opacity) was 2.64:1 -- the whole footer failed. This ground carries white at
    6.99:1. The copyright also runs at full opacity rather than 80% for the same
    reason. */}
<footer class="footer">
  <div class="shell footer__inner">
    <div class="footer__brand">
      {/* Explicit lockup wrapper. This was four siblings in one grid relying on
          auto-placement, and the tagline ended up stacked under the tooth with
          the name adrift in the next column. A flex row and an inner stack say
          what is actually meant: mark beside wordmark. */}
      <div class="footer__lockup">
        {/* tint=currentColor so it inherits the footer's white. As exported
            (#2C9CA6) it would sit at 2.13:1 on this ground. */}
        <Icon name="logo-tooth" width={34} height={42} tint="currentColor" class="footer__mark" />
        <span class="footer__wordmark">
          <span class="footer__name">{site.name}</span>
          <span class="footer__tagline">{site.tagline}</span>
        </span>
      </div>
      <address class="footer__address">
        {site.street},<br />
        {site.locality}, {site.region} {site.postalCode}
      </address>
    </div>

    <nav class="footer__col" aria-label="Footer">
      <h2 class="footer__heading">Explore</h2>
      <ul class="footer__list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading">Visit</h2>
      <ul class="footer__list">
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>

  <p class="footer__legal">
    &copy; {year} {site.name} &middot; {site.dentist} &middot; {site.locality},
    Michigan
  </p>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
    color: var(--white);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem;
  }

  .footer__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .footer__lockup {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  :global(.footer__mark) {
    flex: none;
    width: 2.15rem;
    height: 2.6rem;
  }
  .footer__wordmark {
    display: flex;
    flex-direction: column;
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.1;
  }
  .footer__tagline {
    font-family: var(--font-display);
    font-style: italic;
  }
  .footer__address {
    font-style: normal;
    line-height: 1.2;
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--step-body);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.4);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer a {
    color: inherit;
  }

  /* Navigation, so no underline at rest -- the columns and headings already
     say these are links. It comes back on hover and focus so the affordance is
     never absent when someone is actually reaching for one. */
  .footer__list a {
    text-decoration: none;
  }
  .footer__list a:hover,
  .footer__list a:focus-visible {
    text-decoration: underline;
  }

  .footer :focus-visible {
    outline-color: var(--white);
  }

  .footer__legal {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.4);
    text-align: center;
  }

  @media (min-width: 48rem) {
    .footer__inner {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
