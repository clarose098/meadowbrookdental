---
/* Scroll-snap carousel.
 *
 * The reason this is not a carousel library: with scroll-snap the track is a
 * plain scrollable element, so it is operable by touch, trackpad, arrow keys
 * and screen-reader virtual cursor before a single line of JS runs. The script
 * below only adds the buttons' behaviour and the live announcement -- if it
 * fails to load, the carousel degrades to a scrollable row rather than to a
 * stack of hidden content.
 *
 * Autoplay is opt-in per carousel via `autoplay`, and brings obligations with
 * it. WCAG 2.2.2 (Pause, Stop, Hide) is a Level A criterion: anything that
 * moves automatically, runs longer than five seconds and sits alongside other
 * content MUST have a mechanism to pause it. Hover and focus pausing do not
 * satisfy that -- neither is available to someone reading on a touch screen,
 * and neither is a control you can find. So a visible pause button is rendered
 * whenever autoplay is on, and it is not optional decoration.
 */

interface Props {
  id: string;
  label: string;
  /* What one slide is called, for button and dot labels: "photo", "review". */
  itemNoun: string;
  count: number;
  /* Milliseconds between automatic advances. Omit for a static carousel.
     Setting this also makes the carousel loop, so the arrows wrap rather than
     disabling at the ends -- a looping slideshow whose Next button greys out
     reads as broken. */
  autoplay?: number;
}

const { id, label, itemNoun, count, autoplay } = Astro.props;
---

<div
  class="carousel"
  id={id}
  data-carousel
  data-noun={itemNoun}
  data-autoplay={autoplay}
>
  <div
    class="carousel__viewport"
    role="group"
    aria-roledescription="carousel"
    aria-label={label}
  >
    {/* tabindex makes the scrollable region reachable by keyboard, which
        2.1.1 requires of anything that scrolls independently. */}
    <div class="carousel__track" tabindex="0" data-track>
      <slot />
    </div>
  </div>

  <div class="carousel__controls">
    <button class="carousel__arrow" type="button" data-prev>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M15 4 7 12l8 8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="visually-hidden">Previous {itemNoun}</span>
    </button>

    <div class="carousel__center">
      {autoplay && (
        /* Rendered only when autoplay is on, and hidden again by the script if
           the visitor prefers reduced motion -- there is nothing to pause in
           that case, and a dead control is worse than none. */
        <button
          class="carousel__playpause"
          type="button"
          data-playpause
          data-state="playing"
        >
          <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8 5l11 7-11 7Z" fill="currentColor" />
          </svg>
          <span class="visually-hidden" data-playpause-label>
            Pause the slideshow
          </span>
        </button>
      )}

    <ul class="carousel__dots" data-dots>
      {
        Array.from({ length: count }).map((_, i) => (
          <li>
            <button
              type="button"
              data-dot={i}
              aria-current={i === 0 ? "true" : undefined}
            >
              <span class="visually-hidden">
                Go to {itemNoun} {i + 1} of {count}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    </div>

    <button class="carousel__arrow" type="button" data-next>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M9 4l8 8-8 8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="visually-hidden">Next {itemNoun}</span>
    </button>
  </div>

  {/* Slide changes are announced here rather than by moving focus, so the
      page does not yank a keyboard user around as they browse. */}
  <p class="visually-hidden" aria-live="polite" data-status></p>
</div>

<style>
  /* min-width: 0 on all three.
     A grid or flex child's automatic minimum size is its MIN-CONTENT width, and
     `overflow-x: auto` does not change that -- so the track was reporting the
     full width of its slides up the tree, widening the hero column to 484px
     inside a 335px content box and giving the whole page 1305px of horizontal
     scroll at 375px. The scroll belongs to the track, not the document. */
  .carousel,
  .carousel__viewport {
    min-width: 0;
  }

  .carousel__track {
    display: flex;
    gap: 1rem;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;

    /* The native scrollbar is hidden, not the scrolling. Safe to hide here
       only because the arrows and dots below are always visible and carry the
       same affordance -- the track also stays keyboard-scrollable via its
       tabindex and arrow-key handler. Do not hide it in a context without
       visible controls. */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__track > :global(*) {
    flex: 0 0 100%;
    /* start, not center: with full-width slides the two look identical, but
       start makes the scroll offset of slide N simply its distance from slide
       0, which is what the script below relies on. */
    scroll-snap-align: start;

    /* Makes each slide a containing block for absolutely positioned
       descendants. Without it, the .visually-hidden spans inside the slides
       resolved against an ancestor far up the tree, escaped the track's
       overflow clipping entirely, and were counted against the DOCUMENT's
       scroll width -- 1185px against a 375px viewport. Chromium tolerated it,
       but the page was genuinely 3x too wide on real devices. */
    position: relative;
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .carousel__arrow {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .carousel__arrow svg {
    width: 22px;
    height: 22px;
  }
  .carousel__arrow[disabled] {
    opacity: 0.4;
    cursor: default;
  }

  .carousel__center {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  /* Same 44px target as the social chips and comfortably past the 24x24
     minimum in 2.5.8. Smaller than the arrows because it is a secondary
     control, but never hidden -- 2.2.2 needs it findable, not discoverable. */
  .carousel__playpause {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .carousel__playpause svg {
    width: 18px;
    height: 18px;
  }
  .carousel__playpause[data-state="playing"] .icon-play,
  .carousel__playpause[data-state="paused"] .icon-pause {
    display: none;
  }

  .carousel__dots {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .carousel__dots button {
    width: 11px;
    height: 11px;
    padding: 0;
    border-radius: 50%;
    /* Explicit inherit: a <button> takes `color: buttontext` from the UA
       stylesheet rather than inheriting, so currentColor here resolved to
       black and the idle dots came out black on the teal. */
    color: inherit;
    border: 1px solid var(--carousel-dot, currentColor);
    background: transparent;
    cursor: pointer;
  }
  /* State is carried by FILL as well as colour, and by aria-current for
     assistive tech. The Figma paginator distinguishes the active dot by hue
     alone -- amber against grey -- and those two sit 1.33:1 apart in
     luminance, so in greyscale or to a colour-blind user they are the same
     dot. Filling the active one is the fix, and it is why the amber here is
     an accent on top of the state rather than the state itself. */
  .carousel__dots button[aria-current="true"] {
    background: var(--carousel-dot-active, currentColor);
    border-color: var(--carousel-dot-active, currentColor);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    if (!track) return;

    const slides = Array.from(track.children) as HTMLElement[];
    const noun = root.dataset.noun ?? "item";
    let index = 0;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const playPause = root.querySelector<HTMLButtonElement>("[data-playpause]");
    const playPauseLabel = root.querySelector<HTMLElement>(
      "[data-playpause-label]",
    );
    /* Reduced motion switches autoplay off entirely rather than merely
       shortening it. Someone who has asked the OS for less movement has not
       asked for faster movement. */
    const interval =
      !reduceMotion && root.dataset.autoplay
        ? Number(root.dataset.autoplay)
        : 0;
    const loop = interval > 0;

    let snapTimer: number | undefined;

    function restoreSnap() {
      track!.style.scrollSnapType = "";
    }

    function go(to: number, announce = true) {
      index = loop
        ? (to + slides.length) % slides.length
        : Math.max(0, Math.min(to, slides.length - 1));

      // Measuring from slide 0 cancels out the track's padding and any
      // offsetParent difference, and accounts for the flex gap.
      const left = slides[index].offsetLeft - slides[0].offsetLeft;

      if (reduceMotion) {
        track!.scrollLeft = left;
      } else {
        // `scroll-snap-type: mandatory` cancels programmatic smooth scrolls:
        // the scroll begins and is immediately snapped back to where it
        // started, so the dots and the live region advanced while the slide
        // itself never moved. Lifting snap for the duration of the animation
        // fixes it; snapping is restored as soon as the scroll settles, so
        // touch and trackpad still snap normally.
        track!.style.scrollSnapType = "none";
        track!.scrollTo({ left, behavior: "smooth" });

        window.clearTimeout(snapTimer);
        if ("onscrollend" in window) {
          track!.addEventListener("scrollend", restoreSnap, { once: true });
          // Belt and braces: scrollend does not fire if the scroll is a no-op.
          snapTimer = window.setTimeout(restoreSnap, 1000);
        } else {
          snapTimer = window.setTimeout(restoreSnap, 600);
        }
      }

      sync(announce);
    }

    function sync(announce: boolean) {
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      if (!loop) {
        if (prev) prev.disabled = index === 0;
        if (next) next.disabled = index === slides.length - 1;
      }
      if (announce && status) {
        status.textContent = `${noun} ${index + 1} of ${slides.length}`;
      }
    }

    /* ---- Autoplay ----
       Only runs when `interval` is set and reduced motion is not requested. */
    let timer: number | undefined;
    let stopped = false;   // the visitor took over; do not restart on its own
    let paused = false;    // transient: pointer over it, focus inside, tab hidden

    function tick() {
      /* announce: false. The live region exists so a manual change is spoken;
         firing it every few seconds unprompted would make the page talk over
         whatever someone was actually reading. */
      go(index + 1, false);
    }

    function runTimer() {
      window.clearInterval(timer);
      if (interval && !stopped && !paused) {
        timer = window.setInterval(tick, interval);
      }
    }

    function setPaused(value: boolean) {
      paused = value;
      runTimer();
    }

    /* Hard stop, kept separate from the transient pause. Once someone has
       chosen a slide themselves, pulling it away from them a few seconds later
       is the single most irritating thing a carousel can do. */
    function stopAutoplay() {
      if (!interval || stopped) return;
      stopped = true;
      window.clearInterval(timer);
      if (playPause) playPause.dataset.state = "paused";
      if (playPauseLabel) playPauseLabel.textContent = "Play the slideshow";
    }

    if (interval) {
      playPause?.addEventListener("click", () => {
        if (stopped) {
          stopped = false;
          if (playPause) playPause.dataset.state = "playing";
          if (playPauseLabel) playPauseLabel.textContent = "Pause the slideshow";
          runTimer();
        } else {
          stopAutoplay();
        }
      });

      /* Hover and focus are a courtesy on top of the button, not the mechanism
         2.2.2 asks for -- neither exists on a touch screen. */
      root.addEventListener("mouseenter", () => setPaused(true));
      root.addEventListener("mouseleave", () => setPaused(false));
      root.addEventListener("focusin", () => setPaused(true));
      root.addEventListener("focusout", () => setPaused(false));

      /* No point advancing slides nobody can see, and it avoids returning to a
         tab that has silently moved on. */
      document.addEventListener("visibilitychange", () =>
        setPaused(document.hidden),
      );

      runTimer();
    } else if (playPause) {
      /* Autoplay is off because of reduced motion, so the control has nothing
         to act on. */
      playPause.hidden = true;
    }

    prev?.addEventListener("click", () => {
      stopAutoplay();
      go(index - 1);
    });
    next?.addEventListener("click", () => {
      stopAutoplay();
      go(index + 1);
    });
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        stopAutoplay();
        go(i);
      }),
    );

    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        stopAutoplay();
        go(index - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        stopAutoplay();
        go(index + 1);
      }
    });

    // Keep state honest when the user scrolls the track directly rather than
    // using the controls. Announcing here would interrupt, so it stays silent.
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const i = slides.indexOf(entry.target as HTMLElement);
              if (i >= 0 && i !== index) {
                index = i;
                sync(false);
              }
            }
          });
        },
        { root: track, threshold: 0.6 },
      );
      slides.forEach((slide) => observer.observe(slide));
    }

    sync(false);
  });
</script>
